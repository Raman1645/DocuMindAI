# Ignore documentation directory
docs/

# Environment variables & API keys (Never commit secrets)
.env
.env.local
*.env

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# Python Byte Code & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Vector Databases & Local Runtime Stores (Generated dynamically)
chroma_db/
chroma_*/
*.sqlite3

# User Uploaded Documents & Local Registry (sample_data/ is tracked)
data/*.pdf
data/*.txt
data/document_registry.json
!data/.gitkeep

# IDE & OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
