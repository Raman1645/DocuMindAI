# Environment Variables for Document Q&A Assistant

# Groq API Key (Recommended for ultra-fast, free/low-cost open models)
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Choice (e.g., llama-3.1-8b-instant, llama3-70b-8192, mixtral-8x7b-32768)
LLM_MODEL_NAME=llama-3.1-8b-instant

# Optional: OpenAI API Key (if using OpenAI models instead)
# OPENAI_API_KEY=your_openai_api_key_here
